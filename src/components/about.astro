---
import { loadData } from "@/lib/parser";

const cv = await loadData();
---

{
  cv.profile.philosophy && (
    <section id="about" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">How I think about it</h2>
        <h3 class="text-4xl md:text-5xl font-medium mb-6">About</h3>
        <p class="text-[var(--white-icon)] max-w-2xl leading-relaxed">
          {cv.profile.philosophy}
        </p>
      </div>
    </section>
  )
}
