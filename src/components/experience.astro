---
import { loadData } from "@/lib/parser";

const cv = await loadData();

function formatDate(dateStr?: string | null, isCurrent?: boolean) {
  if (isCurrent) return "Present";
  return dateStr || "";
}
---

<section
  id="experience"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Where I've worked</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Experience</h3>

    <div class="flex flex-col gap-6">
      {
        cv.experience.map((item) => (
          <article class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <div>
                <h4 class="text-xl font-semibold">{item.role}</h4>
                <p class="text-[var(--white-icon)]">
                  {item.company}
                  {item.location && <span> • {item.location}</span>}
                </p>
              </div>
              <span class="text-sm text-[var(--white-icon)] whitespace-nowrap">
                {item.startDate} – {formatDate(item.endDate, item.current)}
              </span>
            </div>

            {item.description && (
              <p class="mt-3 text-[var(--white-icon)]">{item.description}</p>
            )}

            {item.highlights.length > 0 && (
              <ul class="mt-3 space-y-1.5 text-sm text-[var(--white-icon)]">
                {item.highlights.map((hl) => (
                  <li class="flex gap-2">
                    <span class="text-[var(--sec)]">•</span>
                    <span>{hl}</span>
                  </li>
                ))}
              </ul>
            )}

            {item.technologies.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {item.technologies.map((tech) => (
                  <span class="text-xs px-2.5 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)]">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
