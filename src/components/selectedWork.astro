---
import { loadData } from "@/lib/parser";

const cv = await loadData();
const currentRole = cv.experience.find((item) => item.current) ?? cv.experience[0];
---

<section
  id="selected-work"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">What I actually build</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-6">Selected Work</h3>
    <p class="text-[var(--white-icon)] max-w-2xl mb-8">
      Most of my professional work has been on private enterprise codebases,
      so I can't share a public repo — but I can describe the shape of the
      problems and how I've approached them.
    </p>

    {
      currentRole && (
        <article class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6 mb-6">
          <h4 class="text-2xl font-semibold">Enterprise E-commerce Platform</h4>
          <p class="text-[var(--sec)] text-sm mb-3">
            {currentRole.company} · Salesforce Commerce Cloud
          </p>
          {currentRole.description && (
            <p class="text-[var(--white-icon)]">{currentRole.description}</p>
          )}
        </article>
      )
    }

    <h4 class="text-xl font-semibold mt-10 mb-4">Technical Case Studies</h4>

    <div
      class="cs-tabs flex gap-1 border-b border-[var(--white-icon-tr)] mb-6 overflow-x-auto"
      role="tablist"
    >
      {
        cv.caseStudies.map((study, index) => (
          <button
            type="button"
            role="tab"
            id={`cs-tab-${index}`}
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`cs-panel-${index}`}
            tabindex={index === 0 ? "0" : "-1"}
            data-tab={index}
            class:list={[
              "cs-tab text-sm text-[var(--white-icon)] hover:text-white bg-transparent border-0 border-b-2 border-transparent px-1 pb-3 mr-6 whitespace-nowrap transition-colors",
              index === 0 && "cs-tab-active",
            ]}
          >
            <span class="text-[var(--sec)] font-mono text-xs mr-1.5">
              {String(index + 1).padStart(2, "0")}
            </span>
            {study.shortTitle ?? study.title}
          </button>
        ))
      }
    </div>

    {
      cv.caseStudies.map((study, index) => (
        <article
          id={`cs-panel-${index}`}
          role="tabpanel"
          aria-labelledby={`cs-tab-${index}`}
          tabindex="0"
          data-panel={index}
          class:list={[
            "cs-panel rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6",
            index !== 0 && "hidden",
          ]}
        >
          <h5 class="text-xl font-semibold mb-4">{study.title}</h5>
          <div class="flex flex-col gap-3 text-sm">
            <div>
              <p class="text-[var(--sec)] uppercase tracking-wide text-xs mb-1">Context</p>
              <p class="text-[var(--white-icon)]">{study.context}</p>
            </div>
            <div>
              <p class="text-[var(--sec)] uppercase tracking-wide text-xs mb-1">Problem</p>
              <p class="text-[var(--white-icon)]">{study.problem}</p>
            </div>
            <div>
              <p class="text-[var(--sec)] uppercase tracking-wide text-xs mb-1">Approach</p>
              <p class="text-[var(--white-icon)]">{study.approach}</p>
            </div>
            <div>
              <p class="text-[var(--sec)] uppercase tracking-wide text-xs mb-1">Technical decisions</p>
              <p class="text-[var(--white-icon)]">{study.decisions}</p>
            </div>
            <div>
              <p class="text-[var(--sec)] uppercase tracking-wide text-xs mb-1">Result</p>
              <p class="text-[var(--white-icon)]">{study.result}</p>
            </div>
            {study.lessonsLearned && (
              <div>
                <p class="text-[var(--sec)] uppercase tracking-wide text-xs mb-1">Lessons learned</p>
                <p class="text-[var(--white-icon)]">{study.lessonsLearned}</p>
              </div>
            )}
          </div>
          {study.technologies.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {study.technologies.map((tech) => (
                <span class="text-xs px-2.5 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)]">
                  {tech}
                </span>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .cs-tabs {
    scrollbar-width: none;
  }

  .cs-tabs::-webkit-scrollbar {
    display: none;
  }

  .cs-tab.cs-tab-active {
    color: #fff;
    border-bottom-color: var(--sec);
  }

  @keyframes cs-fade-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cs-panel.cs-fade-in {
    animation: cs-fade-in 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-panel.cs-fade-in {
      animation: none;
    }
  }
</style>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#selected-work .cs-tab")
  );
  const panels = document.querySelectorAll<HTMLElement>(
    "#selected-work .cs-panel"
  );
  const tablist = document.querySelector<HTMLElement>(
    "#selected-work .cs-tabs"
  );

  function activateTab(tab: HTMLButtonElement) {
    const target = tab.dataset.tab;
    if (tab.classList.contains("cs-tab-active")) return;

    tabs.forEach((t) => {
      const isActive = t === tab;
      t.classList.toggle("cs-tab-active", isActive);
      t.setAttribute("aria-selected", String(isActive));
      t.setAttribute("tabindex", isActive ? "0" : "-1");
    });

    panels.forEach((panel) => {
      const isTarget = panel.dataset.panel === target;
      panel.classList.toggle("hidden", !isTarget);
      panel.classList.toggle("cs-fade-in", isTarget);
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => activateTab(tab));
  });

  // Roving tabindex: arrow keys move focus between tabs and activate
  // the one landed on, per the WAI-ARIA tabs pattern.
  tablist?.addEventListener("keydown", (event) => {
    const key = (event as KeyboardEvent).key;
    const direction = key === "ArrowRight" ? 1 : key === "ArrowLeft" ? -1 : 0;
    if (!direction) return;

    event.preventDefault();
    const currentIndex = tabs.findIndex((t) =>
      t.classList.contains("cs-tab-active")
    );
    const nextIndex = (currentIndex + direction + tabs.length) % tabs.length;
    const nextTab = tabs[nextIndex];
    nextTab.focus();
    activateTab(nextTab);
  });
</script>
