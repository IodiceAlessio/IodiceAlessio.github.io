---
import Tag from "@/components/Tag.astro";
import { loadData } from "@/lib/parser";

const cv = await loadData();

const githubUrl =
  cv.profile.socials.find((s) => s.platform.toLowerCase() === "github")
    ?.url ?? "https://github.com";
---

<section
  id="personal-projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Beyond the day job</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-6">Personal Projects</h3>
    <p class="text-[var(--white-icon)] max-w-2xl mb-8">
      Most of my professional work has been on private enterprise codebases —
      these are the personal experiments where I explore tools I don't touch
      day to day.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        cv.projects.map((project) => (
          <article class="flex flex-col rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6">
            <div class="flex items-start justify-between gap-3">
              <h4 class="text-2xl font-semibold min-w-0">{project.title}</h4>
              {project.status && <Tag class="shrink-0">{project.status}</Tag>}
            </div>

            {project.description && (
              <p class="mt-2 text-[var(--white-icon)]">
                {project.description}
              </p>
            )}

            {project.highlights.length > 0 && (
              <ul class="mt-3 space-y-1.5 text-sm text-[var(--white-icon)]">
                {project.highlights.map((hl) => (
                  <li class="flex gap-2">
                    <span class="text-[var(--sec)]">•</span>
                    <span>{hl}</span>
                  </li>
                ))}
              </ul>
            )}

            {project.roadmap.length > 0 && (
              <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm text-[var(--white-icon)]">
                {project.roadmap.map((item) => (
                  <li class="flex items-center gap-2">
                    <span
                      class={`flex items-center justify-center size-4 rounded border ${
                        item.done
                          ? "border-[var(--sec)] bg-[var(--sec)] text-[var(--background)]"
                          : "border-[var(--white-icon-tr)]"
                      }`}
                    >
                      {item.done && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="size-3"
                        >
                          <path d="M9.00016 16.1701L4.83016 12.0001L3.41016 13.4101L9.00016 19.0001L21.0002 7.00008L19.5902 5.59009L9.00016 16.1701Z" />
                        </svg>
                      )}
                    </span>
                    <span class={item.done ? "" : "opacity-70"}>{item.label}</span>
                  </li>
                ))}
              </ul>
            )}

            {project.technologies.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <span class="text-xs px-2.5 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)]">
                    {tech}
                  </span>
                ))}
              </div>
            )}

            {project.url && (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex items-center gap-2 self-start text-sm text-[var(--white-icon)] hover:text-white transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-4"
                >
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                </svg>
                View project
              </a>
            )}
          </article>
        ))
      }
    </div>

    <a
      target="_blank"
      href={githubUrl}
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md">More on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
