---
import { loadData } from "@/lib/parser";

const cv = await loadData();
---

<section
  id="education"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Background</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">
      Education & Certifications
    </h3>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {
        cv.education.length > 0 && (
          <div class="flex flex-col gap-6">
            <h4 class="text-sm uppercase tracking-wide text-[var(--white-icon)]">
              Education
            </h4>
            {cv.education.map((item) => (
              <article class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                  <div>
                    <h5 class="text-lg font-semibold">
                      {item.degree}
                      {item.fieldOfStudy ? ` • ${item.fieldOfStudy}` : ""}
                    </h5>
                    <p class="text-[var(--white-icon)]">
                      {item.institution}
                      {item.location && <span> • {item.location}</span>}
                    </p>
                  </div>
                  <span class="text-sm text-[var(--white-icon)] whitespace-nowrap">
                    {item.startDate} – {item.endDate || "Present"}
                  </span>
                </div>

               
              </article>
            ))}
          </div>
        )
      }

      {
        cv.certifications.length > 0 && (
          <div class="flex flex-col gap-6">
            <h4 class="text-sm uppercase tracking-wide text-[var(--white-icon)]">
              Certifications
            </h4>
            {cv.certifications.map((cert) => (
              <article class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6">
                <div class="flex items-baseline justify-between gap-2">
                  <div>
                    {cert.url ? (
                      <a
                        href={cert.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-lg font-semibold hover:text-[var(--sec)] transition-colors"
                      >
                        {cert.title}
                      </a>
                    ) : (
                      <h5 class="text-lg font-semibold">{cert.title}</h5>
                    )}
                    <p class="text-[var(--white-icon)]">{cert.issuer}</p>
                  </div>
                  <span class="text-sm text-[var(--white-icon)] whitespace-nowrap">
                    {cert.date}
                  </span>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
