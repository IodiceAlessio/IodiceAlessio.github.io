---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={[
    "text-xs uppercase tracking-wide px-2.5 py-1 rounded-full border border-[rgba(164,118,255,0.28)] bg-[rgba(164,118,255,0.1)] text-[var(--sec)]",
    className,
  ]}
>
  <slot />
</span>
