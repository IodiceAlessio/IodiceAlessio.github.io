---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Home from "@/components/home.astro";
import SelectedWork from "@/components/selectedWork.astro";
import PersonalProjects from "@/components/personalProjects.astro";
import Experience from "@/components/experience.astro";
import Tech from "@/components/tech.astro";
import About from "@/components/about.astro";
import Education from "@/components/education.astro";
import Footer from "@/components/footer.astro";
---

<Layout>
  <Nav />
  <Home />
  <SelectedWork />
  <PersonalProjects />
  <Experience />
  <Tech />
  <About />
  <Education />
  <Footer />

  <script>
    function triggerPdfPrint(printUrl = "/print/ats") {
      let iframe = document.getElementById(
        "cv-hidden-print-frame"
      ) as HTMLIFrameElement | null;

      if (iframe) {
        iframe.remove();
      }

      iframe = document.createElement("iframe");
      iframe.id = "cv-hidden-print-frame";
      iframe.style.position = "fixed";
      iframe.style.right = "0";
      iframe.style.bottom = "0";
      iframe.style.width = "0";
      iframe.style.height = "0";
      iframe.style.border = "0";
      iframe.style.visibility = "hidden";
      document.body.appendChild(iframe);

      iframe.onload = () => {
        setTimeout(() => {
          try {
            iframe.contentWindow?.focus();
            iframe.contentWindow?.print();
          } catch (err) {
            console.error("Print dialog failed:", err);
          }
        }, 250);
      };

      iframe.src = printUrl;
    }

    document.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement | null)?.closest(
        "[data-print-pdf]"
      );
      if (target) {
        event.preventDefault();
        const type = target.getAttribute("data-print-pdf");
        const printUrl = type === "design" ? "/print/design" : "/print/ats";
        triggerPdfPrint(printUrl);
      }
    });
  </script>
</Layout>
